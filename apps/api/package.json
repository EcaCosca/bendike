{
  "name": "@bendike/api",
  "version": "0.1.0",
  "private": true,
  "description": "Bendike API: accounts, roles and authentication",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "jest",
    "test:unit:cov": "jest --coverage",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "seed:catalog": "ts-node -P tsconfig.json -r tsconfig-paths/register scripts/seed-catalog.ts",
    "drive:authorize": "ts-node -P tsconfig.json -r tsconfig-paths/register scripts/authorize-drive.ts",
    "seed:dev-accounts": "ts-node -P tsconfig.json -r tsconfig-paths/register scripts/seed-dev-accounts.ts",
    "seed:services": "ts-node -P tsconfig.json -r tsconfig-paths/register scripts/seed-services.ts",
    "import:squirrel": "ts-node -P tsconfig.json -r tsconfig-paths/register scripts/import-squirrel.ts",
    "import:fleet": "ts-node -P tsconfig.json -r tsconfig-paths/register scripts/import-fleet.ts",
    "seed:learn": "ts-node -P tsconfig.json -r tsconfig-paths/register scripts/seed-learn.ts",
    "seed:squirrel-tv": "ts-node -P tsconfig.json -r tsconfig-paths/register scripts/seed-squirrel-tv.ts",
    "translate:backfill": "ts-node -P tsconfig.json -r tsconfig-paths/register scripts/backfill-translations.ts"
  },
  "dependencies": {
    "@bendike/shared": "0.1.0",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "11.0.3",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "google-auth-library": "^11.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.30"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",
    "@types/express": "5.0.6",
    "@types/passport-jwt": "4.0.1",
    "exceljs": "^4.4.0",
    "playwright": "^1.47.2",
    "ts-node": "10.9.2"
  }
}
