PORT=3000
DATABASE_URL=postgres://bendike:bendike@localhost:5432/bendike
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600
CORS_ORIGIN=http://localhost:5173
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
# Email for the rigger digest. console writes to the API log; resend sends for real (see the README).
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Bendike <onboarding@resend.dev>
# While testing, send every email to this address instead of the real recipient.
EMAIL_OVERRIDE_TO=
# Shared secret the scheduler sends in the x-cron-secret header; leave empty to keep the job endpoint closed.
CRON_SECRET=
# Where links in emails point.
WEB_BASE_URL=http://localhost:5173
# Optional: machine translation of shop copy (see the README). Without a key new copy stays in English.
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com
# Optional: where the exchange rates come from, and where uploaded photos are stored.
EXCHANGE_RATE_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
UPLOADS_DIR=./uploads
# Manual library storage. Empty means local disk in LIBRARY_LOCAL_DIR (development only). To use Google Drive, run
# `npm run drive:authorize -w @bendike/api` once and paste the four values it prints.
LIBRARY_LOCAL_DIR=./library-files
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
