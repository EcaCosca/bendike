{
  "name": "bendike",
  "version": "0.1.0",
  "private": true,
  "description": "Bendike monorepo: React web app, NestJS API and shared domain types",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky && npm run build:shared",
    "build:shared": "npm run build -w @bendike/shared",
    "build": "npm run build:shared && npm run build -w @bendike/api -w @bendike/web",
    "dev:api": "npm run start:dev -w @bendike/api",
    "dev:web": "npm run dev -w @bendike/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:unit:cov": "npm run test:unit:cov --workspaces --if-present",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit && npm run build"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "ts-jest": "29.4.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0"
  }
}
